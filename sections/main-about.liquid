<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .about-page {
    background: #ffffff;
  }
  
  .about-hero {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    padding: 100px 20px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .about-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 70% 50%, rgba(212, 165, 116, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  
  .about-hero-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .about-badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
    background: linear-gradient(135deg, #d4a574 0%, #c9a66b 100%);
    padding: 8px 20px;
    border-radius: 999px;
    margin-bottom: 24px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(212, 165, 116, 0.3);
  }
  
  .about-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    margin: 0 0 24px;
    color: #1a1a1a;
    line-height: 1.2;
  }
  
  .about-subtitle {
    font-size: 18px;
    color: #6b7280;
    line-height: 1.7;
    max-width: 700px;
    margin: 0 auto;
  }
  
  .about-content {
    max-width: 1280px;
    margin: 0 auto;
    padding: 100px 20px;
  }
  
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    margin-bottom: 100px;
  }
  
  .about-grid:nth-child(even) {
    direction: rtl;
  }
  
  .about-grid:nth-child(even) > * {
    direction: ltr;
  }
  
  .about-image {
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: #f8f9fa;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  }
  
  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .about-image:hover img {
    transform: scale(1.05);
  }
  
  .about-text h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 20px;
  }
  
  .about-text p {
    font-size: 16px;
    color: #6b7280;
    line-height: 1.8;
    margin-bottom: 16px;
  }
  
  .stats-section {
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    padding: 80px 20px;
    margin: 100px 0;
  }
  
  .stats-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    text-align: center;
  }
  
  .stat-item {
    padding: 32px 20px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                background 0.4s ease;
  }
  
  .stat-item:hover {
    transform: translateY(-8px);
    background: rgba(212, 165, 116, 0.1);
  }
  
  .stat-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    color: #d4a574;
    margin: 0 0 8px;
  }
  
  .stat-label {
    font-size: 14px;
    color: #ffffff;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }
  
  .values-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 100px 20px;
  }
  
  .values-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .values-header h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 16px;
  }
  
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  
  .value-card {
    background: #f8f9fa;
    padding: 40px 32px;
    border-radius: 16px;
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.4s ease;
  }
  
  .value-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    background: #ffffff;
  }
  
  .value-icon {
    font-size: 48px;
    margin-bottom: 20px;
    display: block;
  }
  
  .value-title {
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 12px;
  }
  
  .value-text {
    font-size: 15px;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
  }
  
  @media (max-width: 968px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .about-grid:nth-child(even) {
      direction: ltr;
    }
    
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    
    .values-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  
  @media (max-width: 768px) {
    .about-hero {
      padding: 80px 20px;
    }
    
    .about-content {
      padding: 60px 20px;
    }
    
    .stats-section {
      padding: 60px 20px;
      margin: 60px 0;
    }
    
    .values-section {
      padding: 60px 20px;
    }
  }
</style>

<section class="about-page">
  <div class="about-hero">
    <div class="about-hero-content scroll-reveal">
      <span class="about-badge">Our Story</span>
      <h1 class="about-title">{{ page.title }}</h1>
      <p class="about-subtitle">
        Crafting exceptional shopping experiences with premium quality products and unmatched service since our founding.
      </p>
    </div>
  </div>
  
  <div class="about-content">
    <div class="about-grid">
      <div class="about-image scroll-reveal delay-100">
        <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&h=1000&fit=crop" alt="Our Story" loading="lazy">
      </div>
      <div class="about-text scroll-reveal delay-200">
        <h2>Premium Quality, Timeless Style</h2>
        <p>
          Founded with a passion for excellence, we curate only the finest products that combine premium quality with timeless design. Every item in our collection is carefully selected to meet our exacting standards.
        </p>
        <p>
          Our commitment to authenticity and craftsmanship has earned us the trust of thousands of customers worldwide who share our appreciation for quality and style.
        </p>
      </div>
    </div>
    
    <div class="about-grid">
      <div class="about-image scroll-reveal delay-100">
        <img src="https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?w=800&h=1000&fit=crop" alt="Our Mission" loading="lazy">
      </div>
      <div class="about-text scroll-reveal delay-200">
        <h2>Designed for Modern Living</h2>
        <p>
          We believe that great products should enhance your daily life. That's why we focus on designs that are both beautiful and functional, created for people who value quality and style in equal measure.
        </p>
        <p>
          From our carefully curated collections to our personalized service, everything we do is centered around providing you with an exceptional shopping experience.
        </p>
      </div>
    </div>
  </div>
  
  <div class="stats-section">
    <div class="stats-container">
      <div class="stats-grid">
        <div class="stat-item scroll-reveal delay-100">
          <div class="stat-number">10K+</div>
          <div class="stat-label">Happy Customers</div>
        </div>
        <div class="stat-item scroll-reveal delay-200">
          <div class="stat-number">500+</div>
          <div class="stat-label">Premium Products</div>
        </div>
        <div class="stat-item scroll-reveal delay-300">
          <div class="stat-number">50+</div>
          <div class="stat-label">Countries Served</div>
        </div>
        <div class="stat-item scroll-reveal delay-400">
          <div class="stat-number">4.9★</div>
          <div class="stat-label">Customer Rating</div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="values-section">
    <div class="values-header scroll-reveal">
      <h2>What We Stand For</h2>
    </div>
    
    <div class="values-grid">
      <div class="value-card scroll-reveal delay-100">
        <span class="value-icon">⭐</span>
        <h3 class="value-title">Premium Quality</h3>
        <p class="value-text">
          We never compromise on quality. Every product meets our rigorous standards for excellence and durability.
        </p>
      </div>
      
      <div class="value-card scroll-reveal delay-200">
        <span class="value-icon">🤝</span>
        <h3 class="value-title">Customer First</h3>
        <p class="value-text">
          Your satisfaction is our priority. We're here to provide exceptional service and support every step of the way.
        </p>
      </div>
      
      <div class="value-card scroll-reveal delay-300">
        <span class="value-icon">🌍</span>
        <h3 class="value-title">Sustainability</h3>
        <p class="value-text">
          We're committed to ethical practices and sustainability in everything we do, from sourcing to packaging.
        </p>
      </div>
      
      <div class="value-card scroll-reveal delay-400">
        <span class="value-icon">🎨</span>
        <h3 class="value-title">Timeless Design</h3>
        <p class="value-text">
          Our curated collections feature designs that transcend trends, offering lasting style and versatility.
        </p>
      </div>
      
      <div class="value-card scroll-reveal delay-500">
        <span class="value-icon">🚚</span>
        <h3 class="value-title">Fast Shipping</h3>
        <p class="value-text">
          Get your orders quickly and safely with our reliable shipping partners worldwide.
        </p>
      </div>
      
      <div class="value-card scroll-reveal delay-600">
        <span class="value-icon">💎</span>
        <h3 class="value-title">Authentic Products</h3>
        <p class="value-text">
          Every item is 100% authentic and comes with our guarantee of quality and authenticity.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Page",
  "tag": "section",
  "class": "section-about"
}
{% endschema %}
