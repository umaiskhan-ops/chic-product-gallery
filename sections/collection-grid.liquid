<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .collection-grid-section {
    padding: 60px 20px 100px;
    background: #ffffff;
  }
  
  .collection-grid-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .collection-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
    margin-bottom: 60px;
  }
  
  .collection-product-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
    overflow: hidden;
    background: #f8f9fa;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
  }
  
  .collection-product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  }
  
  .collection-product-image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e9ecef;
    position: relative;
  }
  
  .collection-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  .collection-product-card:hover .collection-product-image img {
    transform: scale(1.08);
  }
  
  .collection-product-info {
    padding: 20px;
  }
  
  .collection-product-vendor {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #d4a574;
    margin: 0 0 8px;
    font-weight: 600;
  }
  
  .collection-product-title {
    font-size: 17px;
    font-weight: 500;
    margin: 0 0 12px;
    color: #1a1a1a;
    line-height: 1.3;
  }
  
  .collection-product-price {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .collection-product-price-compare {
    font-size: 14px;
    color: #6b7280;
    text-decoration: line-through;
    margin-left: 8px;
  }
  
  .collection-product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #d4a574;
    color: #ffffff;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 600;
    z-index: 1;
  }
  
  .collection-empty {
    text-align: center;
    padding: 100px 20px;
    color: #6b7280;
  }
  
  .collection-pagination {
    text-align: center;
  }
  
  @media (max-width: 768px) {
    .collection-product-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 20px;
    }
    
    .collection-grid-section {
      padding: 40px 20px 80px;
    }
  }
</style>

{%- paginate collection.products by 12 -%}
  <section class="collection-grid-section">
    <div class="collection-grid-container">
      {%- if collection.products.size > 0 -%}
        <div class="collection-product-grid">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" class="collection-product-card">
              <div class="collection-product-image">
                {%- if product.compare_at_price > product.price -%}
                  <span class="collection-product-badge">Sale</span>
                {%- endif -%}
                
                {%- if product.featured_image -%}
                  <img 
                    src="{{ product.featured_image | img_url: '600x' }}" 
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="600"
                    height="750">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              
              <div class="collection-product-info">
                {%- if product.vendor != blank -%}
                  <p class="collection-product-vendor">{{ product.vendor }}</p>
                {%- endif -%}
                
                <h3 class="collection-product-title">{{ product.title }}</h3>
                
                <p class="collection-product-price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="collection-product-price-compare">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </p>
              </div>
            </a>
          {%- endfor -%}
        </div>
        
        {%- if paginate.pages > 1 -%}
          <div class="collection-pagination">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty">
          <p style="font-size: 18px; margin: 0 0 12px;">No products found in this collection</p>
          <p style="font-size: 15px;">Check back soon for new arrivals</p>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-collection-grid",
  "settings": []
}
{% endschema %}
