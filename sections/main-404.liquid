<div style="padding: 120px 20px; text-align: center; background: #ffffff; min-height: 60vh; display: flex; align-items: center; justify-content: center;">
  <div style="max-width: 600px; margin: 0 auto;">
    <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 72px; font-weight: 600; margin: 0 0 24px; color: #d4a574;">404</h1>
    <h2 style="font-size: 32px; font-weight: 600; margin: 0 0 16px; color: #1a1a1a;">Page Not Found</h2>
    <p style="font-size: 16px; color: #6b7280; margin: 0 0 40px; line-height: 1.6;">
      The page you were looking for does not exist. It may have been moved or deleted.
    </p>
    <a href="/" style="display: inline-block; padding: 16px 32px; background: #1a1a1a; color: #ffffff; text-decoration: none; border-radius: 999px; font-weight: 600; font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; transition: background 0.3s ease, transform 0.3s ease;"
       onmouseover="this.style.background='#d4a574'; this.style.transform='translateY(-2px)'"
       onmouseout="this.style.background='#1a1a1a'; this.style.transform='translateY(0)'">
      Return to Home
    </a>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-404",
  "settings": []
}
{% endschema %}
