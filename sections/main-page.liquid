<div style="padding: 60px 20px; background: #ffffff;">
  <div style="max-width: 800px; margin: 0 auto;">
    <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 48px; font-weight: 600; margin: 0 0 32px; color: #1a1a1a;">
      {{ page.title }}
    </h1>
    <div style="font-size: 16px; color: #1a1a1a; line-height: 1.75;">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section-page",
  "settings": []
}
{% endschema %}
