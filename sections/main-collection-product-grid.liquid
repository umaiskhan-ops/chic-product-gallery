<div style="padding: 40px 20px; background: #ffffff;">
  <div style="max-width: 1280px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;">
      {%- for product in collection.products -%}
        <a href="{{ product.url }}" style="display: block; text-decoration: none; color: inherit; border-radius: 14px; overflow: hidden; background: #f8f9fa; transition: transform 0.3s ease, box-shadow 0.3s ease;">
          <div style="aspect-ratio: 4 / 5; overflow: hidden; background: #e9ecef;">
            {%- if product.featured_image -%}
              <img 
                src="{{ product.featured_image | img_url: '600x' }}" 
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
                onmouseover="this.style.transform='scale(1.05)'"
                onmouseout="this.style.transform='scale(1)'">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div style="padding: 16px 18px 20px;">
            <h3 style="font-size: 16px; font-weight: 500; margin: 0 0 8px; color: #1a1a1a;">{{ product.title }}</h3>
            <p style="font-size: 15px; font-weight: 600; color: #1a1a1a; margin: 0;">
              {{ product.price | money }}
              {%- if product.compare_at_price > product.price -%}
                <s style="font-size: 14px; color: #6b7280; margin-left: 8px;">{{ product.compare_at_price | money }}</s>
              {%- endif -%}
            </p>
          </div>
        </a>
      {%- else -%}
        <p style="grid-column: 1 / -1; text-align: center; color: #6b7280; padding: 60px 20px;">No products found in this collection.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="margin-top: 60px; text-align: center;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section-collection-product-grid",
  "settings": []
}
{% endschema %}
