<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .cart-page {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    padding: 80px 20px 120px;
    min-height: 70vh;
  }
  
  .cart-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .cart-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .cart-badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
    background: linear-gradient(135deg, #d4a574 0%, #c9a66b 100%);
    padding: 8px 20px;
    border-radius: 999px;
    margin-bottom: 20px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(212, 165, 116, 0.3);
  }
  
  .cart-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    margin: 0;
    color: #1a1a1a;
  }
  
  .cart-content {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 60px;
    align-items: start;
  }
  
  .cart-items-section {
    background: #ffffff;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  
  .cart-item {
    display: flex;
    gap: 24px;
    padding: 32px 0;
    border-bottom: 1px solid #e9ecef;
    animation: slideInUp 0.5s ease;
  }
  
  .cart-item:last-child {
    border-bottom: none;
  }
  
  .item-image {
    width: 140px;
    height: 140px;
    border-radius: 16px;
    object-fit: cover;
    background: #f8f9fa;
    transition: transform 0.3s ease;
  }
  
  .item-image:hover {
    transform: scale(1.05);
  }
  
  .item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .item-vendor {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #d4a574;
    font-weight: 600;
  }
  
  .item-title {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0;
  }
  
  .item-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .item-title a:hover {
    color: #d4a574;
  }
  
  .item-variant {
    font-size: 14px;
    color: #6b7280;
  }
  
  .item-price {
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .item-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: auto;
  }
  
  .qty-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f8f9fa;
    padding: 8px 16px;
    border-radius: 999px;
  }
  
  .qty-btn {
    width: 32px;
    height: 32px;
    border: none;
    background: #ffffff;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #1a1a1a;
    transition: all 0.3s ease;
    font-weight: 600;
  }
  
  .qty-btn:hover {
    background: #d4a574;
    color: #ffffff;
    transform: scale(1.1);
  }
  
  .qty-value {
    min-width: 40px;
    text-align: center;
    font-weight: 600;
    font-size: 16px;
  }
  
  .remove-btn {
    padding: 10px 20px;
    background: transparent;
    border: 1px solid #e9ecef;
    border-radius: 999px;
    color: #ef4444;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .remove-btn:hover {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
    transform: translateY(-2px);
  }
  
  .cart-summary {
    background: #ffffff;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 100px;
  }
  
  .summary-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 24px;
  }
  
  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #e9ecef;
  }
  
  .summary-label {
    font-size: 15px;
    color: #6b7280;
  }
  
  .summary-value {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .summary-total {
    padding: 24px 0 0;
    border-top: 2px solid #1a1a1a;
    margin-top: 16px;
  }
  
  .summary-total .summary-label {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .summary-total .summary-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 32px;
    font-weight: 700;
    color: #d4a574;
  }
  
  .shipping-notice {
    background: rgba(212, 165, 116, 0.1);
    padding: 16px;
    border-radius: 12px;
    margin: 24px 0;
    font-size: 13px;
    color: #1a1a1a;
    text-align: center;
    font-weight: 600;
  }
  
  .checkout-btn {
    width: 100%;
    padding: 18px;
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 4px 20px rgba(26, 26, 26, 0.15);
  }
  
  .checkout-btn:hover {
    background: #d4a574;
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(212, 165, 116, 0.4);
  }
  
  .continue-shopping {
    display: inline-block;
    margin-top: 16px;
    width: 100%;
    padding: 16px;
    background: transparent;
    color: #1a1a1a;
    border: 2px solid #e9ecef;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .continue-shopping:hover {
    border-color: #1a1a1a;
    background: #f8f9fa;
  }
  
  .trust-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #e9ecef;
  }
  
  .trust-badge {
    font-size: 11px;
    color: #6b7280;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  
  .empty-cart {
    text-align: center;
    padding: 100px 20px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  
  .empty-icon {
    font-size: 80px;
    margin-bottom: 24px;
    opacity: 0.3;
  }
  
  .empty-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 12px;
  }
  
  .empty-text {
    font-size: 16px;
    color: #6b7280;
    margin: 0 0 32px;
  }
  
  .empty-btn {
    display: inline-block;
    padding: 16px 36px;
    background: #1a1a1a;
    color: #ffffff;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
  }
  
  .empty-btn:hover {
    background: #d4a574;
    transform: translateY(-2px);
  }
  
  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @media (max-width: 968px) {
    .cart-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .cart-summary {
      position: static;
    }
    
    .cart-items-section {
      padding: 24px;
    }
    
    .cart-item {
      flex-direction: column;
      padding: 24px 0;
    }
    
    .item-image {
      width: 100%;
      height: 240px;
    }
  }
</style>

<section class="cart-page">
  <div class="cart-container">
    <div class="cart-header scroll-reveal">
      <span class="cart-badge">Shopping Cart</span>
      <h1 class="cart-title">Your Cart ({{ cart.item_count }})</h1>
    </div>
    
    {%- if cart.item_count > 0 -%}
      <div class="cart-content">
        <div class="cart-items-section">
          {%- for item in cart.items -%}
            <div class="cart-item scroll-reveal delay-{{ forloop.index | times: 100 }}">
              <img 
                src="{{ item.image | img_url: '300x' }}" 
                alt="{{ item.title }}"
                class="item-image"
                loading="lazy">
              
              <div class="item-details">
                {%- if item.product.vendor != blank -%}
                  <p class="item-vendor">{{ item.product.vendor }}</p>
                {%- endif -%}
                
                <h3 class="item-title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </h3>
                
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                
                <p class="item-price">{{ item.final_line_price | money }}</p>
                
                <div class="item-actions">
                  <div class="qty-controls">
                    <button 
                      class="qty-btn"
                      onclick="updateQuantity({{ forloop.index }}, {{ item.quantity | minus: 1 }})"
                      aria-label="Decrease quantity">
                      −
                    </button>
                    <span class="qty-value">{{ item.quantity }}</span>
                    <button 
                      class="qty-btn"
                      onclick="updateQuantity({{ forloop.index }}, {{ item.quantity | plus: 1 }})"
                      aria-label="Increase quantity">
                      +
                    </button>
                  </div>
                  
                  <button 
                    class="remove-btn"
                    onclick="removeItem({{ forloop.index }})"
                    aria-label="Remove item">
                    Remove
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        
        <div class="cart-summary scroll-reveal delay-200">
          <h2 class="summary-title">Order Summary</h2>
          
          <div class="summary-row">
            <span class="summary-label">Subtotal</span>
            <span class="summary-value">{{ cart.total_price | money }}</span>
          </div>
          
          <div class="summary-row">
            <span class="summary-label">Shipping</span>
            <span class="summary-value">Calculated at checkout</span>
          </div>
          
          {%- if cart.total_price >= 10000 -%}
            <div class="shipping-notice">
              🎉 Congratulations! You got FREE shipping!
            </div>
          {%- else -%}
            {%- assign remaining = 10000 | minus: cart.total_price -%}
            <div class="shipping-notice">
              Add {{ remaining | money }} more for FREE shipping! 🚚
            </div>
          {%- endif -%}
          
          <div class="summary-row summary-total">
            <span class="summary-label">Total</span>
            <span class="summary-value">{{ cart.total_price | money }}</span>
          </div>
          
          <button 
            type="button" 
            class="checkout-btn"
            onclick="window.location.href='/checkout'">
            Proceed to Checkout →
          </button>
          
          <a href="/collections/all" class="continue-shopping">
            Continue Shopping
          </a>
          
          <div class="trust-badges">
            <span class="trust-badge">
              <span>🔒</span>
              Secure Checkout
            </span>
            <span class="trust-badge">
              <span>✓</span>
              Easy Returns
            </span>
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="empty-cart scroll-reveal">
        <div class="empty-icon">🛍️</div>
        <h2 class="empty-title">Your cart is empty</h2>
        <p class="empty-text">Looks like you haven't added anything to your cart yet.</p>
        <a href="/collections/all" class="empty-btn">Start Shopping</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
function updateQuantity(line, quantity) {
  if (quantity < 1) return;
  
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ line: line, quantity: quantity })
  })
  .then(res => res.json())
  .then(data => {
    window.location.reload();
  })
  .catch(err => {
    console.error('Error updating quantity:', err);
  });
}

function removeItem(line) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ line: line, quantity: 0 })
  })
  .then(res => res.json())
  .then(data => {
    window.location.reload();
  })
  .catch(err => {
    console.error('Error removing item:', err);
  });
}
</script>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "class": "section-cart"
}
{% endschema %}
