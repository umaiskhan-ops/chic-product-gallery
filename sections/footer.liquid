<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .footer {
    background: #f8f9fa;
    border-top: 1px solid #e9ecef;
    padding: 60px 20px 32px;
    margin-top: 80px;
  }
  
  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 48px;
    margin-bottom: 48px;
  }
  
  .footer-column h3 {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1a1a;
    margin: 0 0 20px;
  }
  
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .footer-links a {
    color: #6b7280;
    text-decoration: none;
    font-size: 15px;
    transition: color 0.3s ease;
  }
  
  .footer-links a:hover {
    color: #d4a574;
  }
  
  .footer-newsletter {
    margin-bottom: 32px;
  }
  
  .footer-newsletter h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 12px;
    color: #1a1a1a;
  }
  
  .footer-newsletter p {
    color: #6b7280;
    font-size: 15px;
    margin: 0 0 20px;
  }
  
  .newsletter-form {
    display: flex;
    gap: 12px;
    max-width: 500px;
  }
  
  .newsletter-input {
    flex: 1;
    padding: 14px 20px;
    border: 1px solid #e9ecef;
    border-radius: 999px;
    font-size: 15px;
    font-family: inherit;
    background: #ffffff;
  }
  
  .newsletter-input:focus {
    outline: none;
    border-color: #d4a574;
  }
  
  .newsletter-button {
    padding: 14px 32px;
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .newsletter-button:hover {
    background: #d4a574;
    transform: translateY(-2px);
  }
  
  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid #e9ecef;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  
  .footer-copyright {
    color: #6b7280;
    font-size: 14px;
  }
  
  .footer-social {
    display: flex;
    gap: 16px;
  }
  
  .footer-social a {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e9ecef;
    transition: all 0.3s ease;
  }
  
  .footer-social a:hover {
    background: #d4a574;
    border-color: #d4a574;
    transform: translateY(-2px);
  }
  
  .footer-social svg {
    width: 16px;
    height: 16px;
  }
  
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
    
    .newsletter-form {
      flex-direction: column;
    }
  }
</style>

<footer class="footer">
  <div class="footer-container">
    <div class="footer-newsletter">
      <h3>Stay In Touch</h3>
      <p>Subscribe to get special offers, style inspiration, and much more.</p>
      <form class="newsletter-form" action="/contact#newsletter" method="post">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input 
          type="email" 
          name="contact[email]" 
          class="newsletter-input" 
          placeholder="Enter your email"
          required>
        <button type="submit" class="newsletter-button">Subscribe</button>
      </form>
    </div>
    
    <div class="footer-grid">
      <div class="footer-column">
        <h3>Shop</h3>
        <ul class="footer-links">
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="/collections">Collections</a></li>
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>Help</h3>
        <ul class="footer-links">
          <li><a href="/pages/shipping">Shipping Info</a></li>
          <li><a href="/pages/returns">Returns</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/size-guide">Size Guide</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>Company</h3>
        <ul class="footer-links">
          <li><a href="/pages/about">Our Story</a></li>
          <li><a href="/pages/sustainability">Sustainability</a></li>
          <li><a href="/pages/careers">Careers</a></li>
          <li><a href="/pages/press">Press</a></li>
        </ul>
      </div>
      
      <div class="footer-column">
        <h3>Legal</h3>
        <ul class="footer-links">
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
        </ul>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
      </p>
      
      <div class="footer-social">
        <a href="#" title="Instagram" aria-label="Instagram">
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        
        <a href="#" title="Facebook" aria-label="Facebook">
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        
        <a href="#" title="Twitter" aria-label="Twitter">
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
