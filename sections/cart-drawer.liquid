<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  
  .cart-drawer-overlay.active {
    opacity: 1;
    pointer-events: all;
  }
  
  .cart-drawer {
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    max-width: 480px;
    background: #ffffff;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 1000;
    display: flex;
    flex-direction: column;
  }
  
  .cart-drawer.active {
    transform: translateX(0);
  }
  
  .cart-header {
    padding: 24px;
    border-bottom: 1px solid #e9ecef;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .cart-close {
    width: 40px;
    height: 40px;
    border: none;
    background: #f8f9fa;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  
  .cart-close:hover {
    background: #1a1a1a;
    color: #ffffff;
    transform: rotate(90deg);
  }
  
  .cart-progress {
    padding: 20px 24px;
    background: #f8f9fa;
  }
  
  .progress-text {
    font-size: 14px;
    color: #1a1a1a;
    margin-bottom: 12px;
    font-weight: 600;
  }
  
  .progress-bar-wrapper {
    height: 8px;
    background: #e9ecef;
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }
  
  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #d4a574 0%, #c9a66b 100%);
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
  }
  
  .progress-bar::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: shimmer 2s infinite;
  }
  
  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }
  
  .cart-item {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid #e9ecef;
    animation: slideInRight 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  .cart-item-image {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
    background: #f8f9fa;
  }
  
  .cart-item-details {
    flex: 1;
  }
  
  .cart-item-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px;
  }
  
  .cart-item-price {
    font-size: 14px;
    color: #d4a574;
    font-weight: 600;
  }
  
  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  
  .qty-btn {
    width: 32px;
    height: 32px;
    border: 1px solid #e9ecef;
    background: #ffffff;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 16px;
  }
  
  .qty-btn:hover {
    background: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
  }
  
  .qty-value {
    min-width: 32px;
    text-align: center;
    font-weight: 600;
  }
  
  .cart-item-remove {
    background: none;
    border: none;
    color: #ef4444;
    cursor: pointer;
    font-size: 20px;
    padding: 8px;
    transition: transform 0.3s ease;
  }
  
  .cart-item-remove:hover {
    transform: scale(1.2) rotate(90deg);
  }
  
  .cart-footer {
    border-top: 1px solid #e9ecef;
    padding: 24px;
  }
  
  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .cart-total-label {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .cart-total-amount {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 700;
    color: #d4a574;
  }
  
  .cart-checkout {
    width: 100%;
    padding: 18px;
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  .cart-checkout:hover {
    background: #d4a574;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(212, 165, 116, 0.4);
  }
  
  .cart-empty {
    text-align: center;
    padding: 60px 24px;
  }
  
  .cart-empty-icon {
    font-size: 64px;
    margin-bottom: 20px;
    opacity: 0.3;
  }
  
  .cart-empty-text {
    font-size: 16px;
    color: #6b7280;
    margin-bottom: 24px;
  }
  
  /* Confetti Animation */
  .confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    background: #d4a574;
    position: absolute;
    animation: confetti-fall 3s linear;
  }
  
  @keyframes confetti-fall {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translateY(100vh) rotate(720deg);
      opacity: 0;
    }
  }
  
  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<div class="cart-drawer-overlay" data-cart-overlay></div>

<div class="cart-drawer" data-cart-drawer>
  <div class="cart-header">
    <h2 class="cart-title">Your Cart</h2>
    <button class="cart-close" data-cart-close aria-label="Close cart">
      ✕
    </button>
  </div>
  
  <div class="cart-progress" data-cart-progress>
    <p class="progress-text" data-progress-text>
      Add $<span data-remaining>100</span> more for FREE shipping! 🚚
    </p>
    <div class="progress-bar-wrapper">
      <div class="progress-bar" data-progress-bar style="width: 0%"></div>
    </div>
  </div>
  
  <div class="cart-items" data-cart-items>
    <!-- Cart items will be inserted here -->
  </div>
  
  <div class="cart-footer">
    <div class="cart-total">
      <span class="cart-total-label">Total</span>
      <span class="cart-total-amount" data-cart-total>$0.00</span>
    </div>
    <button class="cart-checkout" onclick="window.location.href='/cart'">
      Checkout →
    </button>
  </div>
</div>

<script>
(function() {
  const FREE_SHIPPING_THRESHOLD = 10000; // $100 in cents
  let confettiShown = false;
  
  const cartDrawer = document.querySelector('[data-cart-drawer]');
  const cartOverlay = document.querySelector('[data-cart-overlay]');
  const cartClose = document.querySelector('[data-cart-close]');
  const cartItems = document.querySelector('[data-cart-items]');
  const cartTotal = document.querySelector('[data-cart-total]');
  const progressBar = document.querySelector('[data-progress-bar]');
  const progressText = document.querySelector('[data-progress-text]');
  const remaining = document.querySelector('[data-remaining]');
  
  function openCart() {
    cartDrawer.classList.add('active');
    cartOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  
  function closeCart() {
    cartDrawer.classList.remove('active');
    cartOverlay.classList.remove('active');
    document.body.style.overflow = '';
  }
  
  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }
  
  function createConfetti() {
    const colors = ['#d4a574', '#c9a66b', '#f4d03f', '#ff6b6b', '#4ecdc4'];
    for (let i = 0; i < 50; i++) {
      setTimeout(() => {
        const confetti = document.createElement('div');
        confetti.className = 'confetti';
        confetti.style.left = Math.random() * 100 + '%';
        confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
        confetti.style.width = Math.random() * 10 + 5 + 'px';
        confetti.style.height = confetti.style.width;
        document.body.appendChild(confetti);
        
        setTimeout(() => confetti.remove(), 3000);
      }, i * 30);
    }
  }
  
  function updateProgress(totalPrice) {
    const remaining_amount = Math.max(0, FREE_SHIPPING_THRESHOLD - totalPrice);
    const progress = Math.min(100, (totalPrice / FREE_SHIPPING_THRESHOLD) * 100);
    
    progressBar.style.width = progress + '%';
    remaining.textContent = (remaining_amount / 100).toFixed(2);
    
    if (totalPrice >= FREE_SHIPPING_THRESHOLD) {
      progressText.innerHTML = '🎉 Congratulations! You got FREE shipping!';
      if (!confettiShown) {
        createConfetti();
        confettiShown = true;
      }
    } else {
      confettiShown = false;
    }
  }
  
  async function refreshCart() {
    const res = await fetch('/cart.js');
    const cart = await res.json();
    
    cartTotal.textContent = formatMoney(cart.total_price);
    updateProgress(cart.total_price);
    
    if (cart.items.length === 0) {
      cartItems.innerHTML = `
        <div class="cart-empty">
          <div class="cart-empty-icon">🛍️</div>
          <p class="cart-empty-text">Your cart is empty</p>
        </div>
      `;
      return;
    }
    
    cartItems.innerHTML = cart.items.map(item => `
      <div class="cart-item" data-key="${item.key}">
        <img src="${item.featured_image.url}" alt="${item.title}" class="cart-item-image">
        <div class="cart-item-details">
          <h3 class="cart-item-title">${item.product_title}</h3>
          <p class="cart-item-price">${formatMoney(item.final_line_price)}</p>
          <div class="cart-item-qty">
            <button class="qty-btn" data-qty-minus data-key="${item.key}">−</button>
            <span class="qty-value">${item.quantity}</span>
            <button class="qty-btn" data-qty-plus data-key="${item.key}">+</button>
          </div>
        </div>
        <button class="cart-item-remove" data-remove data-key="${item.key}">🗑️</button>
      </div>
    `).join('');
    
    // Attach event listeners
    cartItems.querySelectorAll('[data-qty-minus]').forEach(btn => {
      btn.addEventListener('click', () => changeQty(btn.dataset.key, -1));
    });
    
    cartItems.querySelectorAll('[data-qty-plus]').forEach(btn => {
      btn.addEventListener('click', () => changeQty(btn.dataset.key, 1));
    });
    
    cartItems.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', () => removeItem(btn.dataset.key));
    });
  }
  
  async function changeQty(key, change) {
    const item = await fetch('/cart.js').then(r => r.json()).then(cart => 
      cart.items.find(i => i.key === key)
    );
    
    if (!item) return;
    
    const newQty = item.quantity + change;
    if (newQty < 1) return;
    
    await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: newQty })
    });
    
    refreshCart();
  }
  
  async function removeItem(key) {
    await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: 0 })
    });
    
    refreshCart();
  }
  
  // Event listeners
  cartClose.addEventListener('click', closeCart);
  cartOverlay.addEventListener('click', closeCart);
  
  // Open cart when clicking cart icon
  document.addEventListener('click', (e) => {
    if (e.target.closest('[href="/cart"]')) {
      e.preventDefault();
      openCart();
      refreshCart();
    }
  });
  
  // Listen for cart updates
  document.addEventListener('cart:updated', () => {
    openCart();
    refreshCart();
  });
  
  // Initial load
  refreshCart();
})();
</script>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
