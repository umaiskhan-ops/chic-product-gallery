{% comment %}
  ============================================================
  Custom Product Page — Variant Image Grouping System
  Shopify Online Store 2.0 compatible (Dawn-based themes)
  ------------------------------------------------------------
  Filters product media by variant option value using image
  ALT text matching. Pure Liquid + vanilla JS. No frameworks.
  ============================================================
{% endcomment %}

{{ 'variant-images.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign featured_alt = current_variant.option1
  assign img_size = section.settings.image_size | default: '800x'
-%}

<section
  class="vig-section"
  id="vig-{{ section.id }}"
  data-section-type="product-main"
  data-product-id="{{ product.id }}"
  data-gallery-layout="{{ section.settings.gallery_layout }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="vig-container">
    <div class="vig-grid">

      {% comment %} ---------- LEFT: MEDIA ---------- {% endcomment %}
      <div class="vig-media">

        {% comment %} Hero image with magnifier + zoom on hover {% endcomment %}
        <div class="vig-hero" data-hero>
          <div class="vig-hero__frame" data-hero-frame>
            {% if featured_image %}
              <img
                class="vig-hero__img is-visible"
                data-hero-img
                src="{{ featured_image | img_url: img_size }}"
                data-zoom-src="{{ featured_image | img_url: '1600x' }}"
                alt="{{ featured_image.alt | default: product.title | escape }}"
                width="800"
                height="600"
                fetchpriority="high">
            {% else %}
              <div class="vig-hero__placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'vig-placeholder-svg' }}
              </div>
            {% endif %}

            <div class="vig-hero__lens" data-hero-lens aria-hidden="true"></div>

            <button class="vig-hero__nav vig-hero__nav--prev" data-hero-prev type="button" aria-label="Previous image">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button class="vig-hero__nav vig-hero__nav--next" data-hero-next type="button" aria-label="Next image">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <span class="vig-hero__counter" data-hero-counter aria-live="polite"></span>
          </div>
        </div>

        {% comment %} ---------- THUMBNAIL GALLERY (variant filtered) ---------- {% endcomment %}
        <div
          class="vig-thumbs vig-thumbs--{{ section.settings.gallery_layout }}"
          data-thumbnail-gallery
          role="list"
        >
          {%- for image in product.images -%}
            {%- liquid
              assign is_match = false
              if image.alt == featured_alt
                assign is_match = true
              endif
              if featured_image and image.id == featured_image.id
                assign is_match = true
              endif
            -%}
            <button
              type="button"
              role="listitem"
              class="vig-thumb{% unless is_match %} is-hidden{% endunless %}{% if featured_image and image.id == featured_image.id %} is-active{% endif %}"
              data-thumbnail-item
              data-image="{{ image | img_url: img_size }}"
              data-zoom="{{ image | img_url: '1600x' }}"
              data-alt="{{ image.alt | escape }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ image | img_url: '160x160', crop: 'center' }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="100"
                height="100"
                loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      </div>

      {% comment %} ---------- RIGHT: PRODUCT INFO ---------- {% endcomment %}
      <div class="vig-info">
        {%- if product.vendor != blank -%}
          <p class="vig-vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="vig-title">{{ product.title }}</h1>

        <div class="vig-price" data-price-wrapper>
          <span class="vig-price__current" data-price>{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="vig-price__compare" data-compare-price>{{ current_variant.compare_at_price | money }}</s>
            <span class="vig-badge">Sale</span>
          {%- else -%}
            <s class="vig-price__compare" data-compare-price hidden></s>
          {%- endif -%}
        </div>

        <p class="vig-availability" data-availability>
          <span class="vig-dot {% if current_variant.available %}is-in{% else %}is-out{% endif %}"></span>
          {% if current_variant.available %}In stock — ready to ship{% else %}Sold out{% endif %}
        </p>

        {% comment %} ---------- VARIANT SELECTORS ---------- {% endcomment %}
        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          class="vig-form"
          data-product-form
          novalidate
        >
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- for option in product.options_with_values -%}
            {%- assign is_color = false -%}
            {%- assign opt_name_down = option.name | downcase -%}
            {%- if opt_name_down contains 'color' or opt_name_down contains 'colour' -%}
              {%- assign is_color = true -%}
            {%- endif -%}

            <div class="vig-option" data-option-index="{{ forloop.index0 }}">
              <div class="vig-option__head">
                <span class="vig-option__name">{{ option.name }}</span>
                <span class="vig-option__value" data-option-selected-value>{{ option.selected_value }}</span>
              </div>

              <div class="vig-option__values {% if is_color %}vig-swatches{% else %}vig-pills{% endif %}">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="{% if is_color %}vig-swatch{% else %}vig-pill{% endif %}{% if value == option.selected_value %} is-selected{% endif %}"
                    data-option-button
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value | escape }}"
                    {% if is_color %}style="--swatch-color: {{ value | downcase | replace: ' ', '' }};"{% endif %}
                    aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                    title="{{ value | escape }}"
                  >
                    {% unless is_color %}{{ value }}{% endunless %}
                    <span class="vig-sr-only">{{ option.name }}: {{ value }}</span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="vig-qty">
            <label class="vig-qty__label" for="vig-qty-{{ section.id }}">Quantity</label>
            <div class="vig-qty__control">
              <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
              <input id="vig-qty-{{ section.id }}" name="quantity" type="number" value="1" min="1" data-qty-input>
              <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div class="vig-button-group">
            <button
              type="submit"
              class="vig-atc"
              data-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-atc-text>
                {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
              </span>
              <span class="vig-atc__spinner" data-atc-spinner hidden></span>
            </button>

            <a href="tel:{{ section.settings.phone_number | default: '+1234567890' }}" class="vig-call-btn">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Call to Order
            </a>
          </div>

          <p class="vig-form__status" data-cart-status role="status" aria-live="polite"></p>
        </form>

        {%- if product.description != blank -%}
          <div class="vig-description rte">{{ product.description }}</div>
        {%- endif -%}

        {% comment %} ---------- RATING & REVIEWS ---------- {% endcomment %}
        <div class="vig-reviews">
          <div class="vig-reviews__summary">
            <div class="vig-reviews__stars">
              <span class="vig-star-rating" data-rating="{{ section.settings.average_rating }}">
                {% for i in (1..5) %}
                  <svg class="vig-star {% if i <= section.settings.average_rating %}is-filled{% endif %}" viewBox="0 0 24 24" width="20" height="20">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
                  </svg>
                {% endfor %}
              </span>
              <span class="vig-reviews__avg">{{ section.settings.average_rating }}.0</span>
              <span class="vig-reviews__count">({{ section.settings.review_count }} reviews)</span>
            </div>
            <button type="button" class="vig-reviews__write-btn" data-write-review>Write a Review</button>
          </div>

          <div class="vig-reviews__list" data-reviews-list>
            {% comment %} Reviews will be populated here {% endcomment %}
            <p class="vig-reviews__empty">No reviews yet. Be the first to review this product!</p>
          </div>

          <div class="vig-review-form" data-review-form hidden>
            <h3 class="vig-review-form__title">Write Your Review</h3>
            <form class="vig-review-form__content">
              <div class="vig-form-group">
                <label>Your Rating <span class="vig-required">*</span></label>
                <div class="vig-star-input">
                  {% for i in (1..5) %}
                    <button type="button" class="vig-star-btn" data-star-value="{{ i }}">
                      <svg viewBox="0 0 24 24" width="28" height="28">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    </button>
                  {% endfor %}
                </div>
                <input type="hidden" name="rating" data-rating-input required>
              </div>

              <div class="vig-form-group">
                <label for="review-name">Your Name <span class="vig-required">*</span></label>
                <input type="text" id="review-name" name="name" required>
              </div>

              <div class="vig-form-group">
                <label for="review-email">Your Email <span class="vig-required">*</span></label>
                <input type="email" id="review-email" name="email" required>
              </div>

              <div class="vig-form-group">
                <label for="review-title">Review Title <span class="vig-required">*</span></label>
                <input type="text" id="review-title" name="title" placeholder="Sum up your experience" required>
              </div>

              <div class="vig-form-group">
                <label for="review-body">Your Review <span class="vig-required">*</span></label>
                <textarea id="review-body" name="body" rows="5" placeholder="Share your thoughts about this product..." required></textarea>
              </div>

              <div class="vig-form-actions">
                <button type="button" class="vig-btn-cancel" data-cancel-review>Cancel</button>
                <button type="submit" class="vig-btn-submit">Submit Review</button>
              </div>
            </form>
          </div>
        </div>

        {%- if section.blocks.size > 0 -%}
          <ul class="vig-features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <li class="vig-feature" {{ block.shopify_attributes }}>
                  <strong>{{ block.settings.title }}</strong>
                  {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {% comment %} ---------- STYLE INSPIRATION ---------- {% endcomment %}
    {%- if section.settings.show_style_inspiration -%}
      {% render 'style-inspiration',
        product: product,
        product_tags: product.tags,
        selected_color: featured_alt,
        heading: section.settings.style_heading
      %}
    {%- endif -%}
  </div>

  {% comment %} Variant data consumed by assets/variant-images.js {% endcomment %}
  <script type="application/json" data-variant-json>
    {{ product.variants | json }}
  </script>
  <script type="application/json" data-images-json>
    [
      {%- for image in product.images -%}
        {
          "id": {{ image.id }},
          "alt": {{ image.alt | default: '' | json }},
          "src": {{ image | img_url: img_size | json }},
          "zoom": {{ image | img_url: '1600x' | json }},
          "thumb": {{ image | img_url: '160x160', crop: 'center' | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

<script>
// Review Form Toggle
document.querySelector('[data-write-review]')?.addEventListener('click', () => {
  const form = document.querySelector('[data-review-form]');
  form.hidden = !form.hidden;
  if (!form.hidden) {
    form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
});

document.querySelector('[data-cancel-review]')?.addEventListener('click', () => {
  document.querySelector('[data-review-form]').hidden = true;
});

// Star Rating Input
const starButtons = document.querySelectorAll('.vig-star-btn');
const ratingInput = document.querySelector('[data-rating-input]');

starButtons.forEach((btn, index) => {
  btn.addEventListener('click', () => {
    const value = parseInt(btn.dataset.starValue);
    ratingInput.value = value;
    
    starButtons.forEach((b, i) => {
      if (i < value) {
        b.classList.add('is-active');
      } else {
        b.classList.remove('is-active');
      }
    });
  });
  
  btn.addEventListener('mouseenter', () => {
    const value = parseInt(btn.dataset.starValue);
    starButtons.forEach((b, i) => {
      if (i < value) {
        b.querySelector('svg').style.fill = 'var(--vig-gold)';
      }
    });
  });
});

document.querySelector('.vig-star-input')?.addEventListener('mouseleave', () => {
  const currentRating = parseInt(ratingInput.value) || 0;
  starButtons.forEach((b, i) => {
    if (i >= currentRating) {
      b.querySelector('svg').style.fill = '#e9ecef';
    }
  });
});

// Form Submission (placeholder - integrate with your review app)
document.querySelector('.vig-review-form__content')?.addEventListener('submit', (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);
  
  console.log('Review submitted:', data);
  alert('Thank you for your review! It will be published after moderation.');
  
  e.target.reset();
  document.querySelector('[data-review-form]').hidden = true;
  ratingInput.value = '';
  starButtons.forEach(b => b.classList.remove('is-active'));
});
</script>

<script src="{{ 'variant-images.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Custom Product Page",
  "tag": "section",
  "class": "section-custom-product",
  "settings": [
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "+1234567890",
      "info": "Enter phone number with country code (e.g., +1234567890)"
    },
    {
      "type": "range",
      "id": "average_rating",
      "label": "Average Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Display average rating (1-5 stars)"
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Number of Reviews",
      "default": 48,
      "info": "Display review count"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "options": [
        { "value": "grid", "label": "Grid (5 columns)" },
        { "value": "slider", "label": "Slider (horizontal scroll)" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Main image size",
      "options": [
        { "value": "600x", "label": "Small (600px)" },
        { "value": "800x", "label": "Medium (800px)" },
        { "value": "1200x", "label": "Large (1200px)" }
      ],
      "default": "800x"
    },
    {
      "type": "checkbox",
      "id": "show_style_inspiration",
      "label": "Show Style Inspiration",
      "default": true
    },
    {
      "type": "text",
      "id": "style_heading",
      "label": "Style Inspiration heading",
      "default": "Complete The Look"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Product feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On all orders over $75" }
      ]
    }
  ],
  "presets": [
    { "name": "Custom Product Page" }
  ]
}
{% endschema %}
