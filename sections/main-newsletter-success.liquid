<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .newsletter-success {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 20px;
    position: relative;
    overflow: hidden;
  }
  
  .newsletter-success::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 50% 50%, rgba(212, 165, 116, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  
  .success-container {
    max-width: 600px;
    text-align: center;
    position: relative;
    z-index: 1;
    animation: fadeInUp 0.8s ease;
  }
  
  .success-icon {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    margin: 0 auto 32px;
    box-shadow: 0 20px 60px rgba(22, 163, 74, 0.3);
    animation: bounce 1s ease;
  }
  
  .success-badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
    background: linear-gradient(135deg, #d4a574 0%, #c9a66b 100%);
    padding: 8px 20px;
    border-radius: 999px;
    margin-bottom: 20px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(212, 165, 116, 0.3);
  }
  
  .success-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    margin: 0 0 16px;
    color: #1a1a1a;
  }
  
  .success-message {
    font-size: 18px;
    color: #6b7280;
    line-height: 1.7;
    margin: 0 0 40px;
  }
  
  .success-perks {
    background: #ffffff;
    padding: 32px;
    border-radius: 20px;
    border: 1px solid rgba(212, 165, 116, 0.1);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    margin-bottom: 40px;
    text-align: left;
  }
  
  .perks-title {
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 20px;
    text-align: center;
  }
  
  .perks-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .perk-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: #1a1a1a;
  }
  
  .perk-icon {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, #d4a574 0%, #c9a66b 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .success-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .success-btn {
    padding: 16px 36px;
    background: #1a1a1a;
    color: #ffffff;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.3s ease;
    display: inline-block;
  }
  
  .success-btn:hover {
    background: #d4a574;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(212, 165, 116, 0.3);
  }
  
  .success-btn-secondary {
    padding: 16px 36px;
    background: transparent;
    color: #1a1a1a;
    text-decoration: none;
    border: 2px solid #e9ecef;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.3s ease;
    display: inline-block;
  }
  
  .success-btn-secondary:hover {
    border-color: #1a1a1a;
    background: #f8f9fa;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }
  
  @media (max-width: 768px) {
    .newsletter-success {
      padding: 80px 20px;
    }
    
    .success-actions {
      flex-direction: column;
    }
    
    .success-btn,
    .success-btn-secondary {
      width: 100%;
    }
  }
</style>

<section class="newsletter-success">
  <div class="success-container">
    <div class="success-icon">✓</div>
    <span class="success-badge">Welcome!</span>
    <h1 class="success-title">You're All Set!</h1>
    <p class="success-message">
      Thank you for subscribing to our newsletter. Get ready to receive exclusive offers, style inspiration, and early access to new arrivals.
    </p>
    
    <div class="success-perks">
      <h2 class="perks-title">What You'll Get:</h2>
      <ul class="perks-list">
        <li class="perk-item">
          <span class="perk-icon">🎁</span>
          Exclusive discounts and special offers
        </li>
        <li class="perk-item">
          <span class="perk-icon">✨</span>
          Early access to new collections
        </li>
        <li class="perk-item">
          <span class="perk-icon">💡</span>
          Style tips and product recommendations
        </li>
        <li class="perk-item">
          <span class="perk-icon">🚚</span>
          Free shipping updates and deals
        </li>
      </ul>
    </div>
    
    <div class="success-actions">
      <a href="/collections/all" class="success-btn">Shop Now</a>
      <a href="/" class="success-btn-secondary">Back to Home</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Success",
  "tag": "section",
  "class": "section-newsletter-success"
}
{% endschema %}
