<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .collections-page {
    background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 50%, #ffffff 100%);
    padding-bottom: 80px;
  }
  
  .collections-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    padding: 100px 20px 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .collections-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 50% 50%, rgba(212, 165, 116, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  
  .collections-header-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .collections-badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
    background: linear-gradient(135deg, #d4a574 0%, #c9a66b 100%);
    padding: 8px 20px;
    border-radius: 999px;
    margin-bottom: 24px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(212, 165, 116, 0.3);
  }
  
  .collections-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    margin: 0 0 20px;
    color: #1a1a1a;
  }
  
  .collections-subtitle {
    font-size: 18px;
    color: #6b7280;
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .collections-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 40px;
  }
  
  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(212, 165, 116, 0.1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.5s ease,
                border-color 0.5s ease;
  }
  
  .collection-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 25px 60px rgba(212, 165, 116, 0.2);
    border-color: rgba(212, 165, 116, 0.3);
  }
  
  .collection-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #e9ecef;
    position: relative;
  }
  
  .collection-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  .collection-card:hover .collection-image img {
    transform: scale(1.1) rotate(1deg);
  }
  
  .collection-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .collection-card:hover .collection-overlay {
    opacity: 1;
  }
  
  .collection-btn {
    padding: 12px 28px;
    background: #ffffff;
    color: #1a1a1a;
    border-radius: 999px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: inline-block;
    transition: all 0.3s ease;
  }
  
  .collection-card:hover .collection-btn {
    background: #d4a574;
    color: #ffffff;
    transform: translateY(-4px);
  }
  
  .collection-info {
    padding: 28px;
    text-align: center;
  }
  
  .collection-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 8px;
    color: #1a1a1a;
  }
  
  .collection-count {
    font-size: 13px;
    color: #d4a574;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  
  .collection-description {
    font-size: 14px;
    color: #6b7280;
    line-height: 1.6;
    margin-top: 12px;
  }
  
  @media (max-width: 768px) {
    .collections-header {
      padding: 80px 20px 60px;
    }
    
    .collections-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

<section class="collections-page">
  <div class="collections-header">
    <div class="collections-header-content scroll-reveal">
      <span class="collections-badge">Shop By Category</span>
      <h1 class="collections-title">Our Collections</h1>
      <p class="collections-subtitle">
        Discover our carefully curated collections, each featuring premium products designed for your lifestyle.
      </p>
    </div>
  </div>
  
  <div class="collections-container">
    <div class="collections-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          {%- assign delay_class = forloop.index0 | modulo: 3 | times: 100 | prepend: 'delay-' -%}
          <a href="{{ collection.url }}" class="collection-card scroll-reveal {{ delay_class }}">
            <div class="collection-image">
              {%- if collection.image -%}
                <img 
                  src="{{ collection.image | img_url: '800x' }}" 
                  alt="{{ collection.image.alt | default: collection.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="600">
              {%- elsif collection.products.first and collection.products.first.featured_image -%}
                <img 
                  src="{{ collection.products.first.featured_image | img_url: '800x' }}" 
                  alt="{{ collection.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="600">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
              
              <div class="collection-overlay">
                <span class="collection-btn">Explore Collection →</span>
              </div>
            </div>
            
            <div class="collection-info">
              <h2 class="collection-name">{{ collection.title }}</h2>
              <p class="collection-count">{{ collection.products_count }} Products</p>
              {%- if collection.description != blank -%}
                <p class="collection-description">{{ collection.description | truncate: 100 }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections List",
  "tag": "section",
  "class": "section-list-collections"
}
{% endschema %}
