<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .featured-collection {
    padding: 80px 20px;
    background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 50%, #ffffff 100%);
    position: relative;
  }
  
  .featured-collection::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 30%, rgba(212, 165, 116, 0.03) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(212, 165, 116, 0.03) 0%, transparent 40%);
    pointer-events: none;
  }
  
  .featured-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .featured-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .featured-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    margin: 0 0 16px;
    color: #1a1a1a;
  }
  
  .featured-subtitle {
    font-size: 16px;
    color: #6b7280;
  }
  
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
  }
  
  .product-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(212, 165, 116, 0.1);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), 
                box-shadow 0.5s ease,
                border-color 0.5s ease;
    will-change: transform;
    position: relative;
  }
  
  .product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(212, 165, 116, 0.05) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 0;
  }
  
  .product-card:hover {
    transform: translateY(-12px) scale(1.02);
    box-shadow: 0 25px 60px rgba(212, 165, 116, 0.2), 
                0 15px 30px rgba(0, 0, 0, 0.1);
    border-color: rgba(212, 165, 116, 0.3);
  }
  
  .product-card:hover::before {
    opacity: 1;
  }
  
  .product-image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    position: relative;
  }
  
  .product-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.02) 100%);
    pointer-events: none;
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  
  .product-card:hover .product-image img {
    transform: scale(1.15) rotate(2deg);
  }
  
  .quick-add {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    padding: 14px 24px;
    background: #1a1a1a;
    color: #ffffff;
    border: none;
    border-radius: 999px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 2;
  }
  
  .product-card:hover .quick-add {
    opacity: 1;
    transform: translateY(0);
  }
  
  .quick-add:hover {
    background: #d4a574;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(212, 165, 116, 0.4);
  }
  
  .quick-add.loading {
    pointer-events: none;
    background: #d4a574;
  }
  
  .quick-add.success {
    background: #16a34a;
  }
  
  .product-info {
    padding: 20px;
    position: relative;
    z-index: 1;
    background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,1) 100%);
  }
  
  .product-vendor {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #d4a574;
    margin: 0 0 8px;
    font-weight: 600;
  }
  
  .product-title {
    font-size: 17px;
    font-weight: 500;
    margin: 0 0 12px;
    color: #1a1a1a;
    line-height: 1.3;
  }
  
  .product-price {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .product-price-compare {
    font-size: 14px;
    color: #6b7280;
    text-decoration: line-through;
    margin-left: 8px;
  }
  
  .product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #d4a574;
    color: #ffffff;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 600;
    z-index: 1;
  }
  
  .view-all {
    text-align: center;
    margin-top: 60px;
  }
  
  .view-all-button {
    display: inline-block;
    padding: 16px 36px;
    border: 2px solid #1a1a1a;
    color: #1a1a1a;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  
  .view-all-button:hover {
    background: #1a1a1a;
    color: #ffffff;
    transform: translateY(-2px);
  }
  
  @media (max-width: 768px) {
    .featured-collection {
      padding: 60px 20px;
    }
    
    .product-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 20px;
    }
  }
</style>

{%- liquid
  assign collection_handle = section.settings.collection
  if collection_handle == blank
    assign collection = collections.all
  else
    assign collection = collections[collection_handle]
  endif
  assign products_to_show = section.settings.products_to_show | default: 8
-%}

<section class="featured-collection">
  <div class="featured-container">
    {%- if section.settings.title != blank -%}
      <div class="featured-header">
        <h2 class="featured-title">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="featured-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    {%- if collection and collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products limit: products_to_show -%}
          {%- assign delay_class = forloop.index0 | modulo: 4 | times: 100 | prepend: 'delay-' -%}
          <a href="{{ product.url }}" class="product-card scroll-reveal {{ delay_class }}">
            <div class="product-image">
              {%- if product.compare_at_price > product.price -%}
                <span class="product-badge">Sale</span>
              {%- endif -%}
              
              {%- if product.featured_image -%}
                <img 
                  src="{{ product.featured_image | img_url: '600x' }}" 
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="750">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
              
              {%- if product.available -%}
                <button class="quick-add" data-quick-add data-product-id="{{ product.variants.first.id }}">
                  Quick Add
                </button>
              {%- else -%}
                <button class="quick-add" style="background: #6b7280; cursor: not-allowed; opacity: 1;" disabled>
                  Sold Out
                </button>
              {%- endif -%}
            </div>
            
            <div class="product-info">
              {%- if product.vendor != blank -%}
                <p class="product-vendor">{{ product.vendor }}</p>
              {%- endif -%}
              
              <h3 class="product-title">{{ product.title }}</h3>
              
              <p class="product-price">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}
                  <span class="product-price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      
      {%- if collection.products.size > products_to_show -%}
        <div class="view-all">
          <a href="{{ collection.url }}" class="view-all-button">View All Products</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p style="text-align: center; color: #6b7280; padding: 60px 20px;">
        No products found in this collection.
      </p>
    {%- endif -%}
  </div>
</section>

<script>
document.querySelectorAll('[data-quick-add]').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    e.preventDefault();
    const variantId = btn.dataset.productId;
    const originalText = btn.textContent;
    
    btn.classList.add('loading');
    btn.textContent = 'Adding...';
    
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      });
      
      if (res.ok) {
        btn.classList.remove('loading');
        btn.classList.add('success');
        btn.textContent = 'Added ✓';
        
        // Trigger cart update event
        document.dispatchEvent(new CustomEvent('cart:updated'));
        
        setTimeout(() => {
          btn.classList.remove('success');
          btn.textContent = originalText;
        }, 2000);
      }
    } catch (err) {
      btn.classList.remove('loading');
      btn.textContent = 'Error';
      setTimeout(() => {
        btn.textContent = originalText;
      }, 2000);
    }
  });
});
</script>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
