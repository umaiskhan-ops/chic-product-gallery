<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap">

<style>
  .featured-collection {
    padding: 80px 20px;
    background: #ffffff;
  }
  
  .featured-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  
  .featured-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .featured-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    margin: 0 0 16px;
    color: #1a1a1a;
  }
  
  .featured-subtitle {
    font-size: 16px;
    color: #6b7280;
  }
  
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
  }
  
  .product-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
    overflow: hidden;
    background: #f8f9fa;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
  }
  
  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
  }
  
  .product-image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e9ecef;
    position: relative;
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  .product-card:hover .product-image img {
    transform: scale(1.08);
  }
  
  .product-info {
    padding: 20px;
  }
  
  .product-vendor {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #d4a574;
    margin: 0 0 8px;
    font-weight: 600;
  }
  
  .product-title {
    font-size: 17px;
    font-weight: 500;
    margin: 0 0 12px;
    color: #1a1a1a;
    line-height: 1.3;
  }
  
  .product-price {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  .product-price-compare {
    font-size: 14px;
    color: #6b7280;
    text-decoration: line-through;
    margin-left: 8px;
  }
  
  .product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #d4a574;
    color: #ffffff;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 600;
    z-index: 1;
  }
  
  .view-all {
    text-align: center;
    margin-top: 60px;
  }
  
  .view-all-button {
    display: inline-block;
    padding: 16px 36px;
    border: 2px solid #1a1a1a;
    color: #1a1a1a;
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  
  .view-all-button:hover {
    background: #1a1a1a;
    color: #ffffff;
    transform: translateY(-2px);
  }
  
  @media (max-width: 768px) {
    .featured-collection {
      padding: 60px 20px;
    }
    
    .product-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 20px;
    }
  }
</style>

{%- liquid
  assign collection_handle = section.settings.collection
  assign collection = collections[collection_handle]
  assign products_to_show = section.settings.products_to_show | default: 8
-%}

<section class="featured-collection">
  <div class="featured-container">
    {%- if section.settings.title != blank -%}
      <div class="featured-header">
        <h2 class="featured-title">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="featured-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    {%- if collection and collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products limit: products_to_show -%}
          <a href="{{ product.url }}" class="product-card">
            <div class="product-image">
              {%- if product.compare_at_price > product.price -%}
                <span class="product-badge">Sale</span>
              {%- endif -%}
              
              {%- if product.featured_image -%}
                <img 
                  src="{{ product.featured_image | img_url: '600x' }}" 
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="750">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            
            <div class="product-info">
              {%- if product.vendor != blank -%}
                <p class="product-vendor">{{ product.vendor }}</p>
              {%- endif -%}
              
              <h3 class="product-title">{{ product.title }}</h3>
              
              <p class="product-price">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}
                  <span class="product-price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      
      {%- if collection.products.size > products_to_show -%}
        <div class="view-all">
          <a href="{{ collection.url }}" class="view-all-button">View All Products</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p style="text-align: center; color: #6b7280; padding: 60px 20px;">
        No products found in this collection.
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": ""
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "default": "all"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
